<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yx.ech.mapper.DataChartMapper">

    <insert id="insertValue">
        UPDATE data_chart
        SET `value` = `value` + 1
        WHERE id = #{a};
    </insert>
</mapper>
